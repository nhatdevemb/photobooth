{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": [
        "src/types/*",
        "src/types/**/*",
        "src/renderer/env.d.ts",
        "src/renderer/**/*",
        "src/renderer/**/*.vue",
        "src/preload/*.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "baseUrl": ".",
        "paths": {
            "@t/*": ["src/types/*"],
            "@renderer/*": ["src/renderer/*"]
        },
        "types": ["@webgpu/types"],
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    }
}
