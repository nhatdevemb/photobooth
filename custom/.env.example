# Photobooth Operator Edition — Sample Environment Configuration
# Copy this file to custom/.env or pass via environment variables.
# NEVER commit real secrets, passwords, or signing keys to Git.

# Runtime
APP_ENV=development
APP_VERSION=1.0.0-mvp
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Default when omitted: custom/runtime-data (production Linux/Docker: /var/lib/photobooth-operator)
# DATA_DIR=/var/lib/photobooth-operator
# DATABASE_PATH=/var/lib/photobooth-operator/db/photobooth.sqlite

# Network & Listener Separation
OPERATOR_BIND=127.0.0.1:8080
GUEST_BIND=0.0.0.0:8081
# Must be a reachable LAN IP/hostname (never localhost, 127.x.x.x, ::1, or 0.0.0.0)
SHARE_BASE_URL=http://192.168.1.50:8081
TRUSTED_HOSTS=127.0.0.1,localhost,192.168.1.50

# Device Adapters (mock | hardware)
# In MVP simulation, use mock. Hardware mode never falls back silently to mock.
CAMERA_ADAPTER=mock
# Windows Canon R10: set CAMERA_ADAPTER=digicamcontrol, enable DCC Webserver/interaction.
DCC_BASE_URL=http://127.0.0.1:5513
# Serial number recommended. Empty selects the only connected camera; multiple cameras fail closed.
DCC_CAMERA_ID=
# Absolute path to the bundled Python executable on Windows (default: python.exe).
# PYTHON_BIN=C:/path/to/python.exe
# browser: use the camera on the laptop/phone opening the operator UI.
# Laptop: localhost; phone over LAN: trusted HTTPS is required (plan/webcam-testing.md).
PRINTER_ADAPTER=mock
PRINTER_QUEUE=Canon_SELPHY_CP1500

# Image & Template Defaults
DEFAULT_LUT=original
DEFAULT_TEMPLATE=vertical-three-v1
DEFAULT_BEAUTY_PRESET=natural
# Beauty AI Engine: auto (prefer LK Magic-WIN native bridge with MediaPipe fallback) | lkmagic | mediapipe
BEAUTY_ENGINE=auto
LKMAGIC_BRIDGE_URL=http://127.0.0.1:5520
# Optional path to LK magic.exe for background startup on Windows
# LKMAGIC_EXECUTABLE=D:/workspace/Photobooth/LK Magic-WIN/LK magic.exe
# Set to 0 to keep Photobooth from starting LK Magic automatically.
LKMAGIC_AUTO_START=1
MAX_JPEG_BYTES=52428800
MAX_IMAGE_PIXELS=60000000

# Lifecycle & Retention
SHARE_TTL_HOURS=24
SESSION_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=30
DISK_LOW_BYTES=2147483648
AUTH_IDLE_TIMEOUT_SECONDS=28800

# Secrets (Replace with `openssl rand -hex 32` in runtime environment)
SHARE_SIGNING_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Timeouts & Worker
COUNTDOWN_SECONDS=3
CAPTURE_TIMEOUT_SECONDS=15
RENDER_TIMEOUT_SECONDS=90
PRINT_SUBMIT_TIMEOUT_SECONDS=10
PRINT_QUERY_TIMEOUT_SECONDS=5
WORKER_HEARTBEAT_SECONDS=2
WORKER_STALE_SECONDS=10
SQLITE_BUSY_TIMEOUT_MS=5000

# Mock Simulator Tuning (only used when CAMERA_ADAPTER=mock / PRINTER_ADAPTER=mock)
MOCK_CAPTURE_DELAY_MS=100
MOCK_COUNTDOWN_DELAY_MS=100
MOCK_FAULT_SCENARIO=none
MOCK_PRINTER_SCENARIO=normal

